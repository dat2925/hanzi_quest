VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Public, HTTPS standalone URL for email callbacks and opening from an MCP host.
VITE_APP_URL=http://127.0.0.1:8787
# Render sets PORT automatically. Leave HOST unset to bind 0.0.0.0 when PORT exists.
# MCP_PORT=8787

# Admin API only, set on the Node server/Render; NEVER prefix these with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=server-only secret from Supabase (or SUPABASE_SERVICE_ROLE_KEY)
